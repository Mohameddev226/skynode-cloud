// ============================================================
// SkyNode Cloud — Control Plane Database Schema
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Platform Users ─────────────────────────────────────────

enum PlatformRole {
  OWNER
  ADMIN
  MEMBER
}

model PlatformUser {
  id            String       @id @default(uuid()) @db.Uuid
  email         String       @unique @db.VarChar(255)
  name          String       @db.VarChar(100)
  passwordHash  String       @db.VarChar(255)
  role          PlatformRole @default(MEMBER)
  emailVerified Boolean      @default(false)
  mfaEnabled    Boolean      @default(false)
  mfaSecret     String?      @db.VarChar(255)
  avatarUrl     String?      @db.VarChar(500)
  lastLoginAt   DateTime?
  failedLogins  Int          @default(0)
  lockedUntil   DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  sessions Session[]
  projects Project[]
  auditLogs AuditLog[]

  @@index([email])
  @@map("platform_users")
}

// ── Sessions ───────────────────────────────────────────────

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  token     String   @unique @db.VarChar(255)
  ipAddress String?  @db.VarChar(45)
  userAgent String?  @db.VarChar(500)
  expiresAt DateTime
  createdAt DateTime @default(now())

  user PlatformUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// ── Projects ───────────────────────────────────────────────

enum ProjectStatus {
  PROVISIONING
  ACTIVE
  PAUSED
  DELETING
  DELETED
  ERROR
}

model Project {
  id            String        @id @default(uuid()) @db.Uuid
  ref           String        @unique @db.VarChar(12)
  slug          String        @unique @db.VarChar(64)
  name          String        @db.VarChar(64)
  description   String?       @db.VarChar(500)
  status        ProjectStatus @default(PROVISIONING)
  ownerId       String        @db.Uuid
  region        String        @default("default") @db.VarChar(50)
  dbHost        String        @default("localhost") @db.VarChar(255)
  dbPort        Int           @default(5432)
  dbName        String        @db.VarChar(100)
  dbUser        String        @db.VarChar(100)
  dbPasswordEnc String        @db.VarChar(500)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  owner   PlatformUser @relation(fields: [ownerId], references: [id])
  apiKeys ApiKey[]
  backups Backup[]

  @@index([ownerId])
  @@index([ref])
  @@index([slug])
  @@index([status])
  @@map("projects")
}

// ── API Keys ───────────────────────────────────────────────

enum ApiKeyType {
  PUBLISHABLE
  SECRET
}

model ApiKey {
  id         String     @id @default(uuid()) @db.Uuid
  projectId  String     @db.Uuid
  name       String     @db.VarChar(100)
  type       ApiKeyType
  keyHash    String     @db.VarChar(255)
  keyPrefix  String     @db.VarChar(12)
  createdAt  DateTime   @default(now())
  expiresAt  DateTime?
  lastUsedAt DateTime?
  revoked    Boolean    @default(false)
  revokedAt  DateTime?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([keyHash])
  @@index([projectId])
  @@map("api_keys")
}

// ── Audit Logs ─────────────────────────────────────────────

enum ActorType {
  PLATFORM_USER
  APP_USER
  SYSTEM
  API_KEY
}

model AuditLog {
  id           String    @id @default(uuid()) @db.Uuid
  actorId      String    @db.Uuid
  actorType    ActorType
  action       String    @db.VarChar(100)
  resourceType String    @db.VarChar(100)
  resourceId   String    @db.VarChar(255)
  metadata     Json?
  ipAddress    String?   @db.VarChar(45)
  userAgent    String?   @db.VarChar(500)
  timestamp    DateTime  @default(now())

  actor PlatformUser? @relation(fields: [actorId], references: [id])

  @@index([actorId])
  @@index([action])
  @@index([resourceType, resourceId])
  @@index([timestamp])
  @@map("audit_logs")
}

// ── Backups ────────────────────────────────────────────────

enum BackupStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
  DELETED
}

enum BackupType {
  AUTOMATIC
  MANUAL
}

model Backup {
  id          String       @id @default(uuid()) @db.Uuid
  projectId   String       @db.Uuid
  fileName    String       @db.VarChar(255)
  filePath    String       @db.VarChar(500)
  sizeBytes   BigInt?
  status      BackupStatus @default(PENDING)
  type        BackupType
  startedAt   DateTime     @default(now())
  completedAt DateTime?
  error       String?      @db.Text

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([status])
  @@map("backups")
}
