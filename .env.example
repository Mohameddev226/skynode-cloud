# ============================================================
# SkyNode Cloud — Environment Variables
# Copy this file to .env and fill in the values
# ============================================================

# --- General ---
NODE_ENV=development
APP_PORT=4000
DASHBOARD_PORT=3000

# --- Control Plane Database ---
DATABASE_URL=postgresql://skynode_api:skynode_api_dev_password@localhost:5432/skynode_control
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=skynode_control
POSTGRES_USER=skynode_api
POSTGRES_PASSWORD=skynode_api_dev_password

# --- Provisioner (elevated — never used at runtime) ---
PROVISIONER_DATABASE_URL=postgresql://skynode_provisioner:skynode_provisioner_dev_password@localhost:5432/postgres
PROVISIONER_USER=skynode_provisioner
PROVISIONER_PASSWORD=skynode_provisioner_dev_password

# --- PostgreSQL Superuser (Docker init only) ---
PG_SUPERUSER=postgres
PG_SUPERUSER_PASSWORD=postgres_dev_password

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=skynode_redis_dev_password

# --- MinIO ---
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=skynode_minio_admin
MINIO_ROOT_PASSWORD=skynode_minio_dev_password

# --- Platform Authentication ---
SESSION_SECRET=CHANGE_ME_TO_A_RANDOM_64_CHAR_STRING
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# --- JWT (Application Auth) ---
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_64_CHAR_STRING
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- API ---
API_URL=http://localhost:4000
DASHBOARD_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# --- Rate Limiting ---
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_TTL=60
AUTH_RATE_LIMIT_MAX=5
